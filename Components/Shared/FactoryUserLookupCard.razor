@inject IFactoryUserService UserService

<UserLookupStatusCard
    Title="@Title"
    UserId="@UserId"
    ServiceDisplayName="IFactoryUserService"
    CardCssClass="card h-100 shadow-sm border-success"
    Result="@_result"
    ErrorMessage="@_errorMessage" />

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public int UserId { get; set; }

    private UserLookupResult? _result;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _result = await UserService.FindUserByIdAsync(UserId);
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
    }
}
